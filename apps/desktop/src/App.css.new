  color: #475569;
}

/* 亮色主题 - 侧边栏导航 */
[data-theme="light"] .nav-item {
  color: #475569;
}

[data-theme="light"] .nav-item:hover {
  background: #ecedf0;
  color: #0f172a;
}

[data-theme="light"] .nav-item.active {
