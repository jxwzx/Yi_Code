}

/* 亮色主题 - 登录页面 */
[data-theme="light"] .login-container {
  background: linear-gradient(135deg, #f2f3f5 0%, #e0e7ff 50%, #f2f3f5 100%);
}

[data-theme="light"] .login-card {
