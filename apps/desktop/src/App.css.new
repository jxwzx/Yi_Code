/* ============ YiCode 全局设计系统 ============ */
:root {
  --primary: #6366f1;
  --primary-light: #818cf8;
  --primary-dark: #4f46e5;
  --secondary: #ec4899;
  --accent: #14b8a6;
  --warning: #f59e0b;
  --danger: #ef4444;
  --success: #10b981;
  --bg-dark: #0f172a;
  --bg-darker: #0a0f1e;
  --bg-main: #0f172a;
  --bg-card: rgba(30, 41, 59, 0.7);
  --bg-card-hover: rgba(51, 65, 85, 0.8);
  --border: rgba(148, 163, 184, 0.15);
  --border-light: rgba(148, 163, 184, 0.25);
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --radius-sm: 8px;
  --radius: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.4);
  --glow-primary: 0 0 20px rgba(99, 102, 241, 0.3);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 亮色主题 */
[data-theme="light"] {
  --bg-dark: #f0f1f3;
  --bg-darker: #e8e9ec;
  --bg-main: #f5f5f7;
  --bg-card: rgba(255, 255, 255, 0.85);
  --bg-card-hover: rgba(245, 245, 247, 0.9);
  --border: rgba(148, 163, 184, 0.18);
  --border-light: rgba(148, 163, 184, 0.28);
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.08);
  --glow-primary: 0 0 20px rgba(99, 102, 241, 0.1);
}

/* 亮色主题下的特殊元素 */
[data-theme="light"] .search-box input {
  background: #f7f8f9;
  border-color: #e2e8f0;
}

[data-theme="light"] .search-box input:focus {
  background: #f7f8f9;
}

[data-theme="light"] .icon-btn {
  background: #ecedf0;
  color: #475569;
}

[data-theme="light"] .icon-btn:hover {
  background: #e2e8f0;
}

[data-theme="light"] .btn-secondary {
  background: #ecedf0;
  color: #475569;
  border-color: #e2e8f0;
}

[data-theme="light"] .btn-secondary:hover {
  background: #e2e8f0;
}

[data-theme="light"] .topbar-user {
  background: #ecedf0;
  border-color: #e2e8f0;
}

[data-theme="light"] .notif-dot {
  background: #ef4444;
}

/* 亮色主题 - AI 面板 */
[data-theme="light"] .ai-header {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(236, 72, 153, 0.05) 100%);
}

[data-theme="light"] .ai-msg.assistant .msg-bubble {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(20, 184, 166, 0.05) 100%);
  border-color: rgba(99, 102, 241, 0.15);
}

[data-theme="light"] .ai-msg.user .msg-bubble {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.08) 0%, rgba(99, 102, 241, 0.05) 100%);
  border-color: rgba(236, 72, 153, 0.15);
}

[data-theme="light"] .ai-input-wrap {
  background: #f2f3f5;
}

[data-theme="light"] .ai-input {
  background: #f7f8f9;
  border-color: #e2e8f0;
}

[data-theme="light"] .ai-input:focus-within {
  background: #f7f8f9;
}

[data-theme="light"] .ai-action-btn {
  background: #ecedf0;
  border-color: #e2e8f0;
  color: #475569;
}

[data-theme="light"] .ai-action-btn:hover {
  background: #e2e8f0;
}

/* 亮色主题 - 输出面板 */
[data-theme="light"] .output-panel {
  background: #f2f3f5;
}

/* 亮色主题 - 代码编辑器 */
[data-theme="light"] .code-textarea {
