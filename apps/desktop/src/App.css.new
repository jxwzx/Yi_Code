[data-theme="light"] .rank-item,
[data-theme="light"] .todo-item,
[data-theme="light"] .activity-item,
[data-theme="light"] .env-item,
[data-theme="light"] .channel-item,
[data-theme="light"] .lesson-item,
[data-theme="light"] .issue-card,
[data-theme="light"] .chat-msg,
[data-theme="light"] .member-item,
