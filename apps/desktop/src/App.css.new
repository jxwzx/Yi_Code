}

/* 亮色主题 - 统计卡片 */
[data-theme="light"] .stat-card {
  background: #f7f8f9;
  border-color: #e2e8f0;
}

/* 亮色主题 - 面板 */
[data-theme="light"] .panel {
  background: #f7f8f9;
  border-color: #e2e8f0;
}

/* 亮色主题 - 用户卡片 */
[data-theme="light"] .user-card {
  background: #ecedf0;
  border-color: #e2e8f0;
}

/* 亮色主题 - 通用深色背景覆盖 */
